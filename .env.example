# ===============================================
#  مفاتيح مزودي الذكاء الاصطناعي
#  ⚠️  الملف ده على السيرفر فقط. ممنوع نهائيًا أي مفتاح
#      يبدأ بـ NEXT_PUBLIC_ — ده معناه إنه هيتبعت للمتصفح.
# ===============================================

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# NVIDIA NIM — مفتاح Free/Testing Tier محدود (~40 req/min, من غير SLA).
# للإنتاج الفعلي لازم مفتاح مدفوع/production من build.nvidia.com.
NVIDIA_API_KEY=nvapi-...

# مهلة الطلب بالمللي ثانية
AI_TIMEOUT_MS=120000

# ---- Firebase (المرحلة الجاية) ----
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=
